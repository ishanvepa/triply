# Supabase project Settings > API. Both values are safe for browser use.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Canonical app origin used in confirmation and OAuth callbacks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enable only after configuring Google in Supabase Auth and Google Cloud.
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false

# Optional CLI-only direct/session-pooler Postgres URI for yarn db:push.
# Keep this credential in .env.local; never give it a NEXT_PUBLIC_ prefix.
SUPABASE_DB_URL=
