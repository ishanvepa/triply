{
  "name": "triply",
  "version": "0.1.0",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:auth": "node --experimental-strip-types --test tests/auth.test.mjs",
    "test:trips": "node --experimental-strip-types --test tests/trips.test.mjs",
    "test:invitations": "node --experimental-strip-types --test tests/invitations.test.mjs",
    "test:dashboard": "node --experimental-strip-types --test tests/dashboard.test.mjs",
    "test:travel-legs": "node --experimental-strip-types --test tests/travel-legs.test.mjs",
    "test:e2e": "playwright test",
    "test:ui": "playwright test --config playwright.ui.config.ts",
    "auth:start": "supabase start --exclude realtime,storage-api,imgproxy,postgres-meta,studio,edge-runtime,logflare,vector,supavisor",
    "db:start": "supabase db start",
    "db:reset": "supabase db reset --local",
    "db:test": "supabase test db --local",
    "db:test:concurrency": "node --test scripts/database-concurrency.test.mjs scripts/travel-leg-concurrency.test.mjs",
    "db:lint": "supabase db lint --local --level warning",
    "db:types": "node --env-file-if-exists=.env.local scripts/database.mjs types",
    "db:push": "node --env-file-if-exists=.env.local scripts/database.mjs push"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "postgres": "^3.4.9",
    "supabase": "^2.121.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
